  {
    "id": "ai.http_fetch",
    "title": "AI 웹 페이지 읽기",
    "description": "AI가 주소의 내용을 가져와 정리해요.",
    "tool_key": "builtin:http_fetch",
    "match": {
      "type": "AI",
      "config.tools.0.name": "builtin:http_fetch",
      "config.tools.1": null
    },
    "fixed": {
      "type": "AI",
      "config": {
        "agentType": "react",
        "credentialId": "",
        "tools": [
          {
            "name": "builtin:http_fetch"
          }
        ]
      }
    },
    "inputFields": [
      {
        "key": "prompt"
      }
    ],
    "fields": {
      "url": {
        "title": "주소"
      },
      "method": {
        "title": "메서드",
        "ref": false,
        "choices": [
          {
            "id": "GET",
            "name": "GET"
          },
          {
            "id": "POST",
            "name": "POST"
          },
          {
            "id": "PUT",
            "name": "PUT"
          },
          {
            "id": "DELETE",
            "name": "DELETE"
          }
        ]
      },
      "headers_json": {
        "title": "헤더",
        "type": "json"
      },
      "body": {
        "title": "본문",
        "type": "text"
      }
    }
  },
  {
    "id": "ai.mcp",
    "title": "AI 에이전트 (MCP)",
    "description": "연결한 MCP 서버의 도구로 AI가 일을 처리해요.",
    "tool_key": null,
    "match": {
      "type": "AI",
      "config.tools.0.name": "mcp",
      "config.tools.1": null
    },
    "fixed": {
      "type": "AI",
      "config": {
        "agentType": "react",
        "credentialId": "",
        "tools": [
          {
            "name": "mcp",
            "config": {}
          }
        ]
      }
    },
    "inputFields": [
      {
        "key": "prompt"
      },
      {
        "key": "catalogId",
        "title": "MCP 서버",
        "type": "string",
        "required": true,
        "ref": false,
        "path": "config.tools.0.config.catalogId",
        "optionsSource": "ieum.mcp_servers"
      }
    ]
  },
  {
    "id": "ai.web_search",
