{
  "node_type": "ACTION",
  "kind": "search",
  "title": "Gmail 메일 찾기",
  "description": "검색어에 맞는 메일을 최근 순으로 찾아요.",
  "tool_key": "builtin:google_gmail_find_email",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "query": {
      "title": "검색어",
      "description": "Gmail 검색창과 같은 문법. 날짜는 PST 자정 기준 — 정확히 하려면 after:<epoch초>"
    },
    "label_ids": {
      "title": "라벨",
      "description": "고른 라벨을 모두 가진 메일",
      "ref": false,
      "optionsSource": "google.gmail_labels"
    },
    "include_spam_trash": {
      "title": "스팸·휴지통 포함",
      "ref": false
    },
    "max_results": {
      "title": "최대 개수",
      "description": "기본 20, 최대 100"
    }
  },
  "outputFields": [
    {
      "key": "found",
      "title": "찾음",
      "type": "boolean",
      "description": "한 건 이상 찾았는지"
    },
    {
      "key": "total",
      "title": "개수",
      "type": "integer"
    },
    {
      "key": "items",
      "title": "메일",
      "type": "object",
      "list": true,
      "children": [
        {
          "key": "messageId",
          "title": "메일 ID",
          "type": "string"
        },
        {
          "key": "threadId",
          "title": "스레드 ID",
          "type": "string"
        },
        {
          "key": "from",
          "title": "보낸 사람",
          "type": "string"
        },
        {
          "key": "to",
          "title": "받는 사람",
          "type": "string"
        },
        {
          "key": "subject",
          "title": "제목",
          "type": "string"
        },
        {
          "key": "snippet",
          "title": "미리보기",
          "type": "text"
        },
        {
          "key": "bodyText",
          "title": "본문",
          "type": "text"
        },
        {
          "key": "receivedAt",
          "title": "받은 시각",
          "type": "datetime"
        },
        {
          "key": "labels",
          "title": "라벨 ID",
          "type": "string",
          "list": true
        }
      ]
    }
  ]
}
