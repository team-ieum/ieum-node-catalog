{
  "node_type": "TRIGGER",
  "kind": "trigger",
  "trigger_type": "FORMS_ANY_RESPONSE",
  "title": "새 폼 응답 또는 수정된 응답",
  "description": "구글 폼에 응답이 새로 들어오거나 수정되면 시작해요.",
  "tool_key": null,
  "builder": true,
  "fixed": {
    "type": "TRIGGER",
    "config": {}
  },
  "inputFields": [
    {
      "key": "form_id",
      "title": "폼",
      "type": "string",
      "required": true,
      "ref": false,
      "description": "지켜볼 폼(편집 화면 주소의 폼 ID도 돼요)",
      "optionsSource": "google.forms"
    }
  ],
  "outputFields": [
    {
      "key": "responseId",
      "title": "응답 ID",
      "type": "string"
    },
    {
      "key": "submittedAt",
      "title": "제출 시각",
      "type": "datetime",
      "description": "마지막으로 제출(수정 포함)한 시각"
    },
    {
      "key": "createdAt",
      "title": "처음 제출 시각",
      "type": "datetime"
    },
    {
      "key": "respondentEmail",
      "title": "응답자 이메일",
      "type": "string",
      "description": "이메일을 수집하는 폼만, 아니면 빈 값"
    },
    {
      "key": "answers",
      "title": "답",
      "type": "dict",
      "dynamic": true,
      "fieldsSource": "google.form_questions",
      "fieldsInputs": [
        "form_id"
      ],
      "description": "질문 ID로 꺼내요. 예: answers.<질문 ID>. 답하지 않은 질문은 없어요"
    },
    {
      "key": "answerList",
      "title": "답 목록",
      "type": "object",
      "list": true,
      "description": "폼 질문 순서",
      "children": [
        {
          "key": "questionId",
          "title": "질문 ID",
          "type": "string"
        },
        {
          "key": "question",
          "title": "질문",
          "type": "string"
        },
        {
          "key": "answer",
          "title": "답",
          "type": "json",
          "description": "글·글 목록·숫자·파일 정보 목록({fileId, fileName, mimeType}) 중 하나"
        }
      ]
    },
    {
      "key": "totalScore",
      "title": "점수",
      "type": "number",
      "description": "퀴즈가 아니면 비어 있어요"
    },
    {
      "key": "isUpdate",
      "title": "수정된 응답",
      "type": "boolean",
      "description": "이미 제출한 응답을 고쳐 다시 제출했는지"
    }
  ]
}
