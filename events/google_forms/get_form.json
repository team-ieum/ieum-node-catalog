      "title": "개수",
      "type": "integer"
    },
    {
      "key": "items",
      "title": "폼",
      "type": "object",
      "list": true,
      "children": [
        {
          "key": "formId",
          "title": "폼 ID",
          "type": "string"
        },
        {
          "key": "title",
          "title": "제목",
          "type": "string"
        },
        {
          "key": "description",
          "title": "설명",
          "type": "text"
        },
        {
          "key": "responderUrl",
          "title": "응답 링크",
          "type": "string"
        },
        {
          "key": "isPublished",
          "title": "게시됨",
          "type": "boolean",
          "description": "예전 형식의 폼은 비어 있어요"
        },
        {
          "key": "isAcceptingResponses",
          "title": "응답 받는 중",
          "type": "boolean",
          "description": "예전 형식의 폼은 비어 있어요"
        },
        {
          "key": "linkedSheetId",
          "title": "연결된 시트 ID",
