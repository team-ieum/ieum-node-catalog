      "choices": [
        {
          "id": "GET",
          "name": "GET"
        },
        {
          "id": "POST",
          "name": "POST"
        },
        {
          "id": "PUT",
          "name": "PUT"
        },
        {
          "id": "DELETE",
          "name": "DELETE"
        }
      ]
    },
    {
      "key": "url",
      "title": "URL",
      "type": "string",
      "required": true
    },
    {
      "key": "headers",
      "title": "헤더",
      "type": "dict"
    },
    {
      "key": "body",
      "title": "본문",
      "type": "text"
    },
    {
      "key": "webhookCredentialId",
      "title": "등록 웹훅",
      "type": "string",
      "ref": false,
      "optionsSource": "ieum.webhooks",
