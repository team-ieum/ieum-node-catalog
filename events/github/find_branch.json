{
  "node_type": "ACTION",
  "kind": "search",
  "title": "GitHub 브랜치 찾기",
  "description": "저장소의 브랜치를 찾아요. 이름을 비우면 브랜치 목록을 가져와요.",
  "tool_key": "builtin:github_find_branch",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "owner": {
      "title": "소유자",
      "description": "저장소를 가진 계정 또는 조직",
      "optionsSource": "github.owners"
    },
    "repo": {
      "title": "저장소",
      "description": "브랜치를 찾을 저장소",
      "optionsSource": "github.repos",
      "optionsInputs": [
        "owner"
      ]
    },
    "branch": {
      "title": "브랜치",
      "description": "비우면 전체 목록(최대 100개)",
      "optionsSource": "github.branches",
      "optionsInputs": [
        "owner",
        "repo"
      ]
    }
  },
  "outputFields": [
    {
      "key": "found",
      "title": "찾음",
      "type": "boolean"
    },
    {
      "key": "total",
      "title": "개수",
      "type": "integer"
    },
    {
      "key": "items",
      "title": "브랜치",
      "type": "object",
      "list": true,
      "children": [
        {
          "key": "name",
          "title": "이름",
          "type": "string"
        },
        {
          "key": "sha",
          "title": "최신 커밋 SHA",
          "type": "string"
        },
        {
          "key": "protected",
          "title": "보호됨",
          "type": "boolean"
        }
      ]
    },
    {
      "key": "message",
      "title": "결과가 없을 때 안내",
      "type": "string"
    }
  ]
}
