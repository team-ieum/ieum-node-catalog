{
  "node_type": "ACTION",
  "kind": "action",
  "title": "GitHub 이슈에 라벨 추가",
  "description": "이슈나 PR에 라벨을 더해요. 기존 라벨은 남아요.",
  "tool_key": "builtin:github_add_labels",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "owner": {
      "title": "소유자",
      "description": "저장소를 가진 계정 또는 조직",
      "optionsSource": "github.owners"
    },
    "repo": {
      "title": "저장소",
      "description": "이슈나 PR이 있는 저장소",
      "optionsSource": "github.repos",
      "optionsInputs": [
        "owner"
      ]
    },
    "issue_number": {
      "title": "이슈 번호",
      "description": "이슈·PR 번호 — 트리거 번호를 넣거나 직접 적어요"
    },
    "labels": {
      "title": "라벨",
      "description": "쉼표로 구분, 저장소에 이미 있는 라벨 이름"
    }
  },
  "outputFields": [
    {
      "key": "number",
      "title": "이슈 번호",
      "type": "integer"
    },
    {
      "key": "labels",
      "title": "라벨",
      "type": "string",
      "list": true
    }
  ]
}
