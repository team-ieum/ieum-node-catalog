{
  "node_type": "ACTION",
  "kind": "action",
  "title": "GitHub 이슈 만들기",
  "description": "저장소에 새 이슈를 만들어요.",
  "tool_key": "builtin:github_create_issue",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "owner": {
      "title": "소유자",
      "description": "저장소를 가진 계정 또는 조직",
      "optionsSource": "github.owners"
    },
    "repo": {
      "title": "저장소",
      "description": "이슈를 만들 저장소",
      "optionsSource": "github.repos",
      "optionsInputs": [
        "owner"
      ]
    },
    "title": {
      "title": "제목"
    },
    "body": {
      "title": "내용",
      "type": "text"
    },
    "labels": {
      "title": "라벨",
      "type": "string",
      "description": "쉼표로 구분, 저장소에 이미 있는 라벨 이름"
    },
    "assignees": {
      "title": "담당자",
      "type": "string",
      "description": "쉼표로 구분한 GitHub 아이디"
    },
    "milestone": {
      "title": "마일스톤",
      "type": "string",
      "optionsSource": "github.milestones",
      "optionsInputs": [
        "owner",
        "repo"
      ]
    }
  },
  "outputFields": [
    {
      "key": "number",
      "title": "이슈 번호",
      "type": "integer"
    },
    {
      "key": "url",
      "title": "이슈 주소",
      "type": "string"
    },
    {
      "key": "title",
      "title": "제목",
      "type": "string"
    },
    {
      "key": "warnings",
      "title": "반영되지 않은 항목",
      "type": "string",
      "list": true
    }
  ]
}
