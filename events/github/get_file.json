{
  "node_type": "ACTION",
  "kind": "search",
  "title": "GitHub 파일 내용 가져오기",
  "description": "저장소 파일의 내용을 10만 자까지 가져와요. 폴더 경로면 안에 든 항목 목록을 줘요.",
  "tool_key": "builtin:github_get_file",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "owner": {
      "title": "소유자",
      "description": "저장소를 가진 계정 또는 조직",
      "optionsSource": "github.owners"
    },
    "repo": {
      "title": "저장소",
      "description": "파일이 있는 저장소",
      "optionsSource": "github.repos",
      "optionsInputs": [
        "owner"
      ]
    },
    "path": {
      "title": "파일 경로",
      "description": "예: src/main.py"
    },
    "ref": {
      "title": "브랜치·태그·커밋",
      "description": "브랜치·태그·커밋 SHA, 비우면 기본 브랜치"
    }
  },
  "outputFields": [
    {
      "key": "found",
      "title": "찾음",
      "type": "boolean"
    },
    {
      "key": "total",
      "title": "개수",
      "type": "integer"
    },
    {
      "key": "items",
      "title": "파일",
      "type": "object",
      "list": true,
      "children": [
        {
          "key": "name",
          "title": "이름",
          "type": "string"
        },
        {
          "key": "path",
          "title": "경로",
          "type": "string"
        },
        {
          "key": "type",
          "title": "종류",
          "type": "string"
        },
        {
          "key": "sha",
          "title": "SHA",
          "type": "string"
        },
        {
          "key": "size",
          "title": "크기(바이트)",
          "type": "integer"
        },
        {
          "key": "content",
          "title": "내용",
          "type": "text"
        },
        {
          "key": "truncated",
          "title": "잘림",
          "type": "boolean"
        }
      ]
    },
    {
      "key": "message",
      "title": "결과가 없을 때 안내",
      "type": "string"
    }
  ]
}
