{
  "node_type": "ACTION",
  "kind": "search",
  "title": "GitHub PR 변경 내용 가져오기",
  "description": "PR에서 바뀐 파일과 diff를 가져와요.",
  "tool_key": "builtin:github_get_pr_files",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "owner": {
      "title": "소유자",
      "description": "저장소를 가진 계정 또는 조직",
      "optionsSource": "github.owners"
    },
    "repo": {
      "title": "저장소",
      "description": "PR이 있는 저장소",
      "optionsSource": "github.repos",
      "optionsInputs": [
        "owner"
      ]
    },
    "pull_number": {
      "title": "PR 번호",
      "description": "트리거의 PR 번호를 넣으세요"
    },
    "include_paths": {
      "title": "포함 경로",
      "description": "쉼표로 구분, 예: src/**"
    },
    "exclude_paths": {
      "title": "제외 경로"
    },
    "max_files": {
      "title": "최대 파일 수",
      "description": "1~300"
    },
    "max_diff_chars": {
      "title": "최대 diff 길이",
      "description": "1000~200000자"
    }
  },
  "outputFields": [
    {
      "key": "found",
      "title": "찾음",
      "type": "boolean"
    },
    {
      "key": "total",
      "title": "개수",
      "type": "integer"
    },
    {
      "key": "items",
      "title": "파일",
      "type": "object",
      "list": true,
      "children": [
        {
          "key": "filename",
          "title": "경로",
          "type": "string"
        },
        {
          "key": "status",
          "title": "상태",
          "type": "string"
        },
        {
          "key": "additions",
          "title": "추가 줄 수",
          "type": "integer"
        },
        {
          "key": "deletions",
          "title": "삭제 줄 수",
          "type": "integer"
        },
        {
          "key": "changes",
          "title": "변경 줄 수",
          "type": "integer"
        }
      ]
    },
    {
      "key": "diff",
      "title": "diff",
      "type": "text"
    },
    {
      "key": "head_sha",
      "title": "최신 커밋 SHA",
      "type": "string"
    },
    {
      "key": "skipped",
      "title": "빠진 파일",
      "type": "object",
      "list": true,
      "children": [
        {
          "key": "filename",
          "title": "경로",
          "type": "string"
        },
        {
          "key": "reason",
          "title": "이유",
          "type": "string"
        }
      ]
    },
    {
      "key": "truncated",
      "title": "잘림",
      "type": "boolean"
    }
  ]
}
