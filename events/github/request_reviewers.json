{
  "node_type": "ACTION",
  "kind": "action",
  "title": "GitHub PR 리뷰어 지정",
  "description": "PR에 리뷰어를 지정해 리뷰를 요청해요.",
  "tool_key": "builtin:github_request_reviewers",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "owner": {
      "title": "소유자",
      "description": "저장소를 가진 계정 또는 조직",
      "optionsSource": "github.owners"
    },
    "repo": {
      "title": "저장소",
      "description": "PR이 있는 저장소",
      "optionsSource": "github.repos",
      "optionsInputs": [
        "owner"
      ]
    },
    "pull_number": {
      "title": "PR 번호",
      "description": "트리거의 PR 번호를 넣거나 번호를 직접 적어요"
    },
    "reviewers": {
      "title": "리뷰어",
      "description": "쉼표로 구분한 GitHub 아이디"
    }
  },
  "outputFields": [
    {
      "key": "number",
      "title": "PR 번호",
      "type": "integer"
    },
    {
      "key": "requested_reviewers",
      "title": "요청된 리뷰어",
      "type": "string",
      "list": true
    }
  ]
}
