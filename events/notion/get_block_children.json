{
  "node_type": "ACTION",
  "kind": "search",
  "title": "Notion 하위 블록 가져오기",
  "description": "블록이나 페이지 바로 아래 블록을 가져와요(한 단계만).",
  "tool_key": "builtin:notion_get_block_children",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "block_id": {
      "title": "블록 ID",
      "description": "블록이나 페이지 ID — 앞 노드 값을 참조하거나 직접 넣어요"
    },
    "output_format": {
      "title": "출력 형식",
      "description": "비우면 Markdown",
      "ref": false,
      "choices": [
        {
          "id": "markdown",
          "name": "Markdown"
        },
        {
          "id": "json",
          "name": "원본 블록 JSON"
        }
      ]
    },
    "page_size": {
      "title": "가져올 개수",
      "description": "한 번에 최대 100개 (기본 100)"
    },
    "start_cursor": {
      "title": "다음 커서",
      "description": "이전 결과의 '다음 커서'를 넣으면 이어서 가져와요"
    }
  },
  "outputFields": [
    {
      "key": "found",
      "title": "찾음",
      "type": "boolean",
      "description": "하위 블록이 하나라도 있는지"
    },
    {
      "key": "total",
      "title": "개수",
      "type": "integer"
    },
    {
      "key": "items",
      "title": "블록",
      "type": "object",
      "list": true,
      "children": [
        {
          "key": "id",
          "title": "ID",
          "type": "string"
        },
        {
          "key": "type",
          "title": "종류",
          "type": "string",
          "description": "paragraph·heading_1·to_do 등"
        },
        {
          "key": "text",
          "title": "글",
          "type": "text"
        },
        {
          "key": "hasChildren",
          "title": "하위 블록 있음",
          "type": "boolean"
        }
      ]
    },
    {
      "key": "markdown",
      "title": "Markdown",
      "type": "text",
      "description": "출력 형식이 Markdown일 때 블록을 이어 붙인 글"
    },
    {
      "key": "raw",
      "title": "원본 블록",
      "type": "json",
      "list": true,
      "description": "출력 형식이 원본 블록 JSON일 때만"
    },
    {
      "key": "nextCursor",
      "title": "다음 커서",
      "type": "string",
      "description": "더 있으면 다음 실행의 '다음 커서'에 넣어요. 없으면 빈 값"
    },
    {
      "key": "hasMore",
      "title": "더 있음",
      "type": "boolean"
    },
    {
      "key": "truncated",
      "title": "잘림",
      "type": "boolean",
      "description": "출력 크기 한도를 넘어 뒤쪽 블록을 뺐는지 — 다음 커서로 이어 가져와요"
    }
  ]
}
