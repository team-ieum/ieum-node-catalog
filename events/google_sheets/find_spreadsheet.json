{
  "node_type": "ACTION",
  "kind": "search",
  "title": "스프레드시트 찾기",
  "description": "이름으로 스프레드시트를 찾아요.",
  "tool_key": "builtin:google_sheets_find_spreadsheet",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "name": {
      "title": "이름",
      "description": "찾을 스프레드시트 이름"
    },
    "match": {
      "title": "일치 방식",
      "description": "정확히 같은 이름만 찾을지, 이름이 이것으로 시작하는 것도 찾을지",
      "choices": [
        {
          "id": "exact",
          "name": "정확히 일치"
        },
        {
          "id": "prefix",
          "name": "앞부분 일치"
        }
      ],
      "ref": false
    }
  },
  "outputFields": [
    {
      "key": "found",
      "title": "찾음",
      "type": "boolean",
      "description": "맞는 스프레드시트가 있는지"
    },
    {
      "key": "total",
      "title": "개수",
      "type": "integer"
    },
    {
      "key": "items",
      "title": "스프레드시트",
      "type": "object",
      "list": true,
      "children": [
        {
          "key": "id",
          "title": "ID",
          "type": "string"
        },
        {
          "key": "name",
          "title": "이름",
          "type": "string"
        },
        {
          "key": "url",
          "title": "링크",
          "type": "string"
        },
        {
          "key": "modified_time",
          "title": "수정 시각",
          "type": "datetime"
        }
      ]
    }
  ]
}
