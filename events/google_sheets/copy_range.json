{
  "node_type": "ACTION",
  "kind": "action",
  "title": "시트 범위 복사",
  "description": "범위를 같은 시트의 다른 위치에 붙여 넣어요.",
  "tool_key": "builtin:google_sheets_copy_range",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "spreadsheet_id": {
      "title": "스프레드시트",
