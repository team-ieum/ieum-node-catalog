    },
    "text_color": {
      "title": "글자색",
      "description": "#RRGGBB(예: #1A73E8). 비우면 그대로"
    },
    "bold": {
      "title": "굵게",
      "ref": false,
      "description": "비우면 그대로, 켜면 적용, 끄면 해제"
    },
    "italic": {
      "title": "기울임",
      "ref": false,
      "description": "비우면 그대로, 켜면 적용, 끄면 해제"
    },
    "strikethrough": {
      "title": "취소선",
      "ref": false,
      "description": "비우면 그대로, 켜면 적용, 끄면 해제"
    }
  },
  "outputFields": [
    {
      "key": "row_count",
