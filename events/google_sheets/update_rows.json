{
  "node_type": "ACTION",
  "kind": "action",
  "title": "시트 여러 행 수정",
  "description": "행 번호마다 값을 한 번에 바꿔요.",
  "tool_key": "builtin:google_sheets_update_rows",
  "builder": true,
  "fixed": {
    "type": "ACTION",
    "config": {}
  },
  "fields": {
    "spreadsheet_id": {
      "title": "스프레드시트",
      "description": "대상 스프레드시트",
      "optionsSource": "google.spreadsheets",
      "ref": false
    },
    "sheet_id": {
      "title": "워크시트",
      "description": "대상 워크시트(탭)",
      "optionsSource": "google.worksheets",
      "optionsInputs": [
        "spreadsheet_id"
      ],
      "ref": false
    },
    "rows": {
      "title": "행 목록",
      "type": "json",
      "description": "항목마다 row_number와 바꿀 열 값. 바꿀 열만 담아요(찾기 결과를 그대로 넣으면 수식이 값으로 바뀌어요)"
    },
    "column_map": {
      "title": "열별 항목 키",
      "type": "dict",
      "ref": false,
      "fieldsSource": "google.sheet_columns",
      "fieldsInputs": [
        "spreadsheet_id",
        "sheet_id"
      ],
      "description": "열마다 목록 항목에서 꺼낼 키 이름(예: email, values.B). 비우면 항목 키를 열 문자·머리글로 읽어요"
    },
    "overwrite_all": {
      "title": "모든 열 덮어쓰기",
      "description": "켜면 비운 열의 기존 값을 지워요",
      "ref": false
    },
    "value_input_option": {
      "title": "입력값 해석",
      "ref": false,
      "description": "전화번호·우편번호처럼 앞자리 0을 지켜야 하면 '그대로 저장'",
      "choices": [
        {
          "id": "USER_ENTERED",
          "name": "자동 변환"
        },
        {
          "id": "RAW",
          "name": "그대로 저장"
        }
      ]
    }
  },
  "outputFields": [
    {
      "key": "row_count",
      "title": "수정한 행 수",
      "type": "integer"
    },
    {
      "key": "row_numbers",
      "title": "수정한 행 번호",
      "type": "integer",
      "list": true
    }
  ]
}
